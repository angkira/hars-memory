# home_run.toml - copy to home_run.toml and (usually) change NOTHING but the paths. Used by scripts/home_run.py
# (HOME-RUNBOOK.md). Paths may use ~ ; nothing secret goes in here (API keys live in the environment).
# Defaults are the small, cheap run decided in Amendment C.3 (budget USD 20-30 in total).

[general]
profile       = "anthropic"                 # FROZEN per decision set (Amendment C.1-4)
mcp           = "http://127.0.0.1:8307/mcp" # your HARS MCP server (see `home_run.py hars-env`)
artifact_root = "/mnt/datasets/ft/artifacts"  # campaigns land in <root>/<UTC>-homerun-<name>/ (never /tmp)
name          = "home"
embedder_id   = ""      # your real embedder id; recorded when the server reports none / checked against it
key_env       = ""      # e.g. "EVAL_API_KEY" to read the key from another variable than ANTHROPIC_API_KEY
min_free_gb   = 30

# HARD USD caps (Amendment C.3-3). 0 = NOT FILLED IN: every paid step refuses to start.
# gen/run/judge are campaign-wide per phase (summed over the tracks) unless a [caps.<track>] override exists;
# `total` is the ceiling over everything. `home_run.py dry-run` prints the estimate against `total`.
#   gen   = QA generation (Claude Code track)
#   run   = replays / compactions / answers + the flagged estimate of HARS extraction
#   judge = the blind judge
[caps]
total = 30.0
gen   = 3.0
run   = 20.0
judge = 5.0
# per-track overrides (optional), same keys:
# [caps.beam]
# run = 12.0

[oh]                                  # OpenHands chain track (Amendment C.6): all 14 chains (single + xspan_locator + unanswerable)
# the unpacked dataset dir; leave empty to auto-detect <artifact_root>/*-oh-multihop-qa, or unpack the tarball with
#   home_run.py --oh-tar ~/oh-multihop-qa-20261026T144511Z.tar.gz dry-run
artifact_dir = ""
batch_chains = 4                      # (--legacy-replay only) chains per run_chainreplay invocation
retries      = 1                      # (--legacy-replay only) re-run invalid / missing (chain, B) cells this many times
budgets      = [1536]                 # primary cell only. OPT-IN protocol sweep: [1536, 1024, 512]
graph_store  = ""                     # <HARS sessions dir> for the funnel's anchor_in_graph stage (optional)
# Amendment C.6: the OH track runs through run_longsession (chains_to_longsession.py -> run_longsession.py); no pi, no cap iteration.
# `home_run.py calibrate` is a cheap parity CHECK of `calibration_chains` sessions (default 1; probe asks only, nothing excluded).
calibration_chains = 1
calibration_seed = 20261026           # the check's session = first of the seeded order (same seed as the old calibration chain)
session_concurrency = 1               # sessions in parallel in run_longsession (the host has an OOM history)
extra_args  = []                      # appended to run_longsession.py (a protocol change if you alter boundaries / budgets!)
# LEGACY (--legacy-replay only, Amendment C.4): the baseline summary cap is a CALIBRATED parity parameter of the pi replay.
baseline_cap       = ""               # "1536:2010,1024:1340" per B, or a table { 1536 = 2010 }
baseline_cap_scale = 0.0              # cap(B) = round(B * scale) for the B not in baseline_cap (0 = unset), e.g. 1.31
calibration_max_iterations = 2        # (legacy) max calibration runs per B

[beam]                                # Amendment C.2/C.3 long-session track: BEAM-1M, a seeded sample
repo        = "~/data/BEAM"           # git clone https://github.com/mohammadtavakoli78/BEAM
size        = "1M"
chats       = "sample"                # "sample" = N seeded chats (C.3-2); "all" = all 35 (about 3.5x the cost)
n_chats     = 10                      # N, fixed before results; the selection is written to beam/selection.json
seed        = 20261026                # random.Random("<seed>:<size>").sample(sorted chat numbers, N)
limit       = 0
checkpoints = "end"
budgets     = [1536]                  # primary only. OPT-IN: [1536, 1024, 512] adds L2/L3 (n/a = p 1 without it)
session_concurrency = 1
extra_args  = []                      # appended to run_longsession.py (a protocol change if you alter window/keep-tail!)

[cc]                                  # your Claude Code transcripts: DESCRIPTIVE only (C.2). Pick the session(s):
#   home_run.py cc --find "HARS Experts Research"      (title / first message substring; prints candidates)
#   home_run.py cc --session-id <cse_... or uuid>      home_run.py cc --list      (longest, with compaction counts)
paths       = []                      # or list transcript files/dirs explicitly; --find/--session-id override this
root        = "~/.claude/projects"    # where --find/--list/--session-id search (*/*.jsonl)
min_tokens  = 0                       # a picked session is never filtered by length
limit       = 0
n_single    = 40                      # menu-mode QA generation (~2 per window)
n_multihop  = 10
n_unanswerable = 4
session_budget_usd = 2.5
checkpoints = "every:3"
budgets     = [1536]
max_questions = 0
extra_args  = []

[smoke]                               # caps of `home_run.py smoke` (cents-level; hard)
run_cap_oh  = 0.90
run_cap_ls  = 0.25
judge_cap   = 0.25

[hars]
data_dir = "~/hars-data/nc-eval"      # used by `hars-env` only
port     = 8307
